# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar este archivo como .env para su uso local
# NUNCA subir el archivo .env real con credenciales al control de versiones
# =============================================================================

# Puerto del servidor backend
SERVER_PORT=8080

# Seguridad JWT (Cadena Base64 de al menos 256 bits para HMAC SHA-256)
JWT_SECRET_BASE64=dGhpcy1pcy1hLXNhbXBsZS1qd3Qtc2VjcmV0LWtleS1mb3ItZGV2LW9ubHktMjU2LWJpdHM=
JWT_EXPIRATION_SECONDS=86400

# Perfil activo de Spring (h2 para pruebas en memoria, mysql para base de datos real)
SPRING_PROFILES_ACTIVE=h2

# Configuración de Base de Datos MySQL (Requerido cuando SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resenas_cursos
DB_USERNAME=root
DB_PASSWORD=tu_contrasena_mysql_aqui

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
